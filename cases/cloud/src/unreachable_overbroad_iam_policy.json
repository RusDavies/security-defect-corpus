{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RetiredAdminPolicy",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::example-app-bucket/*"
    }
  ]
}
